# riscv/virt: NS16550 via device tree (console=ttyS0).
# CONFIG_SERIAL_OF_PLATFORM required: 8250 does not probe DT-enumerated UARTs
# without it — no console device is registered and init stdout is unconnected.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
# Toybox riscv64 binary uses FP instructions in crt0; SIGILL without FPU support.
CONFIG_FPU=y
