# Namespace enablement fragment — applied on top of any base config
# to produce the *nsconfig variant profiles (tinynsconfig, defnsconfig, etc.).
#
# Enables all 8 Linux namespace types plus the supporting kernel subsystems
# (procfs, networking, cgroups) required for namespace test scripts.
#
# Applied by build.sh before olddefconfig; ordering relative to the base
# config fragment does not matter — olddefconfig resolves all dependencies.

CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_TIME_NS=y

# Cgroup namespace requires cgroups core
CONFIG_CGROUPS=y
CONFIG_CGROUP_NS=y

# Supporting subsystems required by namespace test scripts
CONFIG_PROC_FS=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_TMPFS=y
CONFIG_SYSVIPC=y
CONFIG_FUTEX=y
