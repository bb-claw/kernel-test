# defconfig base additions
# Applied after `make defconfig` by build.sh (configs/defconfig.config auto-applied when present).
# Keep this file minimal — only options needed to enable test coverage not in defconfig.

# ── Watchdog subsystem (390_watchdog.sh) ─────────────────────────────────────
# CONFIG_SOFT_WATCHDOG is not set in any arch's defconfig.
# WATCHDOG_SYSFS gives /sys/class/watchdog/watchdog0/{identity,timeout,nowayout,state}.
CONFIG_WATCHDOG=y
CONFIG_SOFT_WATCHDOG=y
CONFIG_WATCHDOG_SYSFS=y
