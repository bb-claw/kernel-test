# VisionFive 2 riscv arch overlay for vf2config.
# riscv defconfig already includes 8250 + OF_PLATFORM + FPU.
# Repeated here for pattern consistency with other riscv profiles.
# Setting =y when already =y is a no-op after olddefconfig.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_FPU=y
