# arm64/virt: ARM PL011 UART (console=ttyAMA0).
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# arm64/virt: 16K/64K page kernels silently fail to boot on QEMU virt/cortex-a57
# (ARMv8.0-A does not support 64K pages; 16K kernels hang before reaching init).
# Same pin as randdefconfig-arm64.config.
CONFIG_ARM64_4K_PAGES=y
