# VisionFive 2 (StarFive JH7110) config profile.
# Base: riscv defconfig (includes most JH7110 drivers already).
# Applied by build.sh after `make defconfig` (riscv-only; arch guard in build.sh).
#
# This fragment:
#   1. Pins CONFIG_LOCALVERSION="-vf2" for uname identification.
#   2. Promotes key JH7110 drivers from =m to =y (initramfs cannot load modules).
#   3. Enables watchdog sysfs + softdog for QEMU test coverage (390_watchdog.sh).
#   4. Disables heavy subsystems that bloat build time without test coverage value.
#
# In QEMU: JH7110 drivers compile in but do not probe (no matching DT nodes) — expected.
# On real VF2 (Phase 6): the same fragment boots without modification.

# ── Identity ──────────────────────────────────────────────────────────────────
CONFIG_LOCALVERSION="-vf2"

# ── Watchdog (390_watchdog.sh) ────────────────────────────────────────────────
# CONFIG_WATCHDOG=y and CONFIG_STARFIVE_WATCHDOG=y are already in riscv defconfig.
# WATCHDOG_SYSFS: /sys/class/watchdog/watchdogN/{identity,timeout,nowayout,state}.
# SOFT_WATCHDOG: provides /dev/watchdog in QEMU (starfive watchdog doesn't probe).
CONFIG_WATCHDOG_SYSFS=y
CONFIG_SOFT_WATCHDOG=y

# ── JH7110 built-in drivers ────────────────────────────────────────────────────
# riscv defconfig sets these =m; promote to =y for initramfs-based boot.
# On real hardware: Ethernet is required for tftp boot (Phase 6 — no modprobe in init).
# STMMAC_ETH / STMMAC_PLATFORM: deps of DWMAC_STARFIVE.
# CLK_STARFIVE_JH7110_AON: always-on clock domain; required by Ethernet and USB.
# CLK_STARFIVE_JH7110_STG: storage/peripheral clock domain; required by USB.
# PHY_STARFIVE_JH7110_USB: USB 2.0 PHY driver.
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_STARFIVE=y
CONFIG_USB_CDNS3=y
CONFIG_USB_CDNS3_STARFIVE=y
CONFIG_CLK_STARFIVE_JH7110_AON=y
CONFIG_CLK_STARFIVE_JH7110_STG=y
CONFIG_PHY_STARFIVE_JH7110_USB=y

# ── Heavy subsystems off ───────────────────────────────────────────────────────
# DRM, SOUND, MEDIA_SUPPORT, STAGING: not exercised by the test suite;
# significant build time on a dense defconfig base.
CONFIG_DRM=n
CONFIG_SOUND=n
CONFIG_MEDIA_SUPPORT=n
CONFIG_STAGING=n
