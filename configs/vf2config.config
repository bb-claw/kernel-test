# VisionFive 2 (StarFive JH7110) config profile.
# Base: riscv defconfig (includes most JH7110 drivers already).
# Applied by build.sh after `make defconfig` (riscv-only; arch guard in build.sh).
#
# This fragment:
#   1. Pins CONFIG_LOCALVERSION="-vf2" for uname identification.
#   2. Promotes key JH7110 drivers from =m to =y (initramfs cannot load modules).
#   3. Enables watchdog sysfs + softdog for QEMU test coverage (390_watchdog.sh).
#   4. Disables heavy subsystems that bloat build time without test coverage value.
#
# In QEMU: JH7110 drivers compile in but do not probe (no matching DT nodes) — expected.
# On real VF2 (Phase 6): the same fragment boots without modification.

# ── Identity ──────────────────────────────────────────────────────────────────
CONFIG_LOCALVERSION="-vf2"

# ── Watchdog (390_watchdog.sh) ────────────────────────────────────────────────
# CONFIG_WATCHDOG=y and CONFIG_STARFIVE_WATCHDOG=y are already in riscv defconfig.
# WATCHDOG_SYSFS: /sys/class/watchdog/watchdogN/{identity,timeout,nowayout,state}.
# SOFT_WATCHDOG: provides /dev/watchdog in QEMU (starfive watchdog doesn't probe).
CONFIG_WATCHDOG_SYSFS=y
CONFIG_SOFT_WATCHDOG=y

# ── Clock domains ─────────────────────────────────────────────────────────────
# CLK_JH7110_SYS / CLK_JH7110_PLL: already =y in riscv defconfig (core system clocks).
# AON: always-on domain — required by Ethernet and USB clock paths.
# STG: storage/peripheral domain — required by USB and PCIe clock paths.
# VOUT: HDMI/display output clock domain; depends on CLK_JH7110_SYS + JH71XX_PMU (=y).
# ISP: Image Signal Processor clock domain; same deps as VOUT.
CONFIG_CLK_STARFIVE_JH7110_AON=y
CONFIG_CLK_STARFIVE_JH7110_STG=y
CONFIG_CLK_STARFIVE_JH7110_VOUT=y
CONFIG_CLK_STARFIVE_JH7110_ISP=y

# ── Ethernet ──────────────────────────────────────────────────────────────────
# Required for tftp boot on real VF2 (Phase 6); init has no modprobe.
# STMMAC_ETH / STMMAC_PLATFORM: deps of DWMAC_STARFIVE.
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_STARFIVE=y

# ── USB ───────────────────────────────────────────────────────────────────────
# USB_CDNS3: Cadence USB3 host/gadget controller core.
# USB_CDNS3_STARFIVE: JH7110 glue layer; requires CLK_AON + CLK_STG (above).
# PHY_STARFIVE_JH7110_USB: USB 2.0 PHY driver.
CONFIG_USB_CDNS3=y
CONFIG_USB_CDNS3_STARFIVE=y
CONFIG_PHY_STARFIVE_JH7110_USB=y

# ── PCIe ──────────────────────────────────────────────────────────────────────
# PCIE_STARFIVE_HOST: PCIe host controller (M.2 slot on VF2); depends on PCI_MSI (=y).
# PHY_STARFIVE_JH7110_PCIE: shared PCIe 2.0 / USB 3.0 PHY.
CONFIG_PCIE_STARFIVE_HOST=y
CONFIG_PHY_STARFIVE_JH7110_PCIE=y

# ── Security & crypto ─────────────────────────────────────────────────────────
# HW_RANDOM_JH7110: hardware TRNG; depends on HW_RANDOM (=y) + SOC_STARFIVE (=y).
# AMBA_PL08X: PL08x DMA controller; depends on ARM_AMBA (=y in defconfig).
#   Required dep for CRYPTO_DEV_JH7110.
# CRYPTO_DEV_JH7110: hardware AES/SHA/SM3 accelerator; depends on SOC_STARFIVE + AMBA_PL08X.
CONFIG_HW_RANDOM_JH7110=y
CONFIG_AMBA_PL08X=y
CONFIG_CRYPTO_DEV_JH7110=y

# ── Performance monitoring ────────────────────────────────────────────────────
# STARFIVE_STARLINK_PMU: L3 cache PMU (bool, not in riscv defconfig despite ARCH_STARFIVE=y).
#   Relevant to 400_perf-events.sh on real VF2: without this, JH7110 cache events unavailable.
# STARFIVE_STARLINK_CACHE: L2/L3 cache controller; required for DMA cache coherency on JH7110.
CONFIG_STARFIVE_STARLINK_PMU=y
CONFIG_STARFIVE_STARLINK_CACHE=y

# ── Heavy subsystems off ───────────────────────────────────────────────────────
# DRM, SOUND, MEDIA_SUPPORT, STAGING: not exercised by the test suite;
# significant build time on a dense defconfig base.
CONFIG_DRM=n
CONFIG_SOUND=n
CONFIG_MEDIA_SUPPORT=n
CONFIG_STAGING=n

# ── MODULES=y retained ────────────────────────────────────────────────────────
# Setting MODULES=n would force olddefconfig to disable every =m option not
# explicitly overridden, requiring enumeration of all riscv defconfig modules.
# With MODULES=y, only the JH7110-specific subset above needs explicit =y.
