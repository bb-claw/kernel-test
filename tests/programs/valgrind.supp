# Shared Valgrind suppressions for kernel-test C programs.
#
# All entries here are glibc false positives — they are NOT bugs in our programs.
# Suppressions are intentionally broad (fun-level only) to remain valid across
# minor glibc version changes.
#
# Why these are false positives:
#   AVX2/SSE2 string functions (__strcmp_avx2, __strncmp_avx2, __strstr_sse2_unaligned)
#   operate on 32- or 16-byte aligned chunks. They may read past the null terminator
#   for alignment, but the comparison result is derived only from bytes up to '\0'.
#   Valgrind sees the aligned over-read as a conditional jump on uninitialised memory.
#
#   NSS module functions (__nss_module_allocate, __nss_action_parse,
#   __nss_module_get_function) read and parse /etc/nsswitch.conf. glibc's NSS
#   machinery does not zero-init internal module state before use, producing
#   spurious uninitialised-value reports unrelated to our code.
#
#   glibc's _int_free() uses SIMD in static builds and reads the adjacent chunk
#   header in 32-byte aligned loads, touching bytes not tracked by Valgrind.
#   Scoped to specific callers to avoid masking real use-after-free bugs.
#
#   perror() triggers glibc locale/gettext initialisation (__dcigettext) which
#   calls free() on lazily-allocated internal state that was never zero-init'd.

# ── AVX2 strcmp ───────────────────────────────────────────────────────────────

{
   glibc_avx2_strcmp
   Memcheck:Cond
   fun:__strcmp_avx2
}

# ── AVX2 strncmp ──────────────────────────────────────────────────────────────

{
   glibc_avx2_strncmp
   Memcheck:Cond
   fun:__strncmp_avx2
}

# ── SSE2 strstr ───────────────────────────────────────────────────────────────

{
   glibc_sse2_strstr
   Memcheck:Cond
   fun:__strstr_sse2_unaligned
}

# ── NSS module loader (getpwuid, passwd lookup) ───────────────────────────────

{
   glibc_nss_module_allocate
   Memcheck:Cond
   fun:__nss_module_allocate
}

{
   glibc_nss_action_parse
   Memcheck:Cond
   fun:__nss_action_parse
}

{
   glibc_nss_module_get_function
   Memcheck:Cond
   fun:__nss_module_get_function
}

# ── _int_free() SIMD over-read (arena_destroy) ────────────────────────────

{
   glibc_free_arena_destroy
   Memcheck:Cond
   fun:free
   fun:arena_destroy
}

# ── dcigettext/locale init via perror() ──────────────────────────────────
# Triggered by perf-event (ENOSYS perror) and serial-capture (read perror).

{
   glibc_dcigettext_free
   Memcheck:Cond
   fun:free
   fun:__dcigettext
}
